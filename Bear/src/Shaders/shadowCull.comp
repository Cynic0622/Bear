#version 450

#include "..\\Renderer\\BaseData.h"

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

struct AABB
{
    vec4 minv;
    vec4 maxv;
};

struct IndirectCommand
{
    uint indexCount;
    uint instanceCount;
    uint firstIndex;
    int  vertexOffset;
    uint firstInstance;
};

layout(set = 0, binding = 0) readonly buffer AABBs       { AABB aabbs[]; }            g_AABBs;
layout(set = 0, binding = 1) readonly buffer InputCmds   { IndirectCommand cmds[]; }  g_Input;
layout(set = 0, binding = 2) buffer OutputCmds           { IndirectCommand cmds[]; }  g_Output;
layout(set = 0, binding = 3) buffer VisibleCounter       { uint count; }              g_Counter;

layout(set = 1, binding = 0) uniform sceneDataBlock { SceneData g_SceneData; };
layout(set = 1, binding = 2) readonly buffer PerObjectSSBO { mat4 models[]; } g_PerObject;

layout(push_constant) uniform PushConstants
{
    vec4 planes[6];
    uint objectCount;
} g_PC;

vec3 transformAabbCenter(vec4 minv, vec4 maxv, mat4 m, out vec3 halfSize)
{
    vec3 center   = (minv.xyz + maxv.xyz) * 0.5;
    halfSize      = (maxv.xyz - minv.xyz) * 0.5;
    vec3 wc = vec3(m * vec4(center, 1.0));
    mat3 rot = mat3(m);
    mat3 absRot = mat3(abs(rot[0]), abs(rot[1]), abs(rot[2]));
    halfSize = absRot * halfSize;
    return wc;
}

bool frustumCulled(vec3 wMin, vec3 wMax)
{
    for (int p = 0; p < 6; ++p)
    {
        vec3 n = g_PC.planes[p].xyz;
        vec3 pv = mix(wMin, wMax, greaterThanEqual(n, vec3(0.0)));
        if (dot(n, pv) + g_PC.planes[p].w < 0.0)
            return true;
    }
    return false;
}

void main()
{
    uint i = gl_GlobalInvocationID.x;
    if (i >= g_PC.objectCount)
        return;

    IndirectCommand cmd = g_Input.cmds[i];
    uint orig = cmd.firstInstance;

    AABB a = g_AABBs.aabbs[orig];
    mat4 m = g_PerObject.models[orig];

    vec3 halfSize;
    vec3 worldCenter = transformAabbCenter(a.minv, a.maxv, m, halfSize);
    vec3 wMin = worldCenter - halfSize;
    vec3 wMax = worldCenter + halfSize;

    if (frustumCulled(wMin, wMax))
        return;

    uint slot = atomicAdd(g_Counter.count, 1u);
    g_Output.cmds[slot] = cmd;
}
