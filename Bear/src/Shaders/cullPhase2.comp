#version 450

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

struct AABB
{
    vec4 min;
    vec4 max;
};

struct IndirectCommand
{
    uint indexCount;
    uint instanceCount;
    uint firstIndex;
    int  vertexOffset;
    uint firstInstance;
};

struct RejectedCommand
{
    IndirectCommand cmd;
    uint materialId;
};

layout(set = 0, binding = 0) uniform BaseDataBlock { mat4 viewMat; mat4 projMat; vec4 cameraPosition; uint frameIndex; } g_BaseData;

layout(set = 1, binding = 2) readonly buffer Matrices     { mat4 models[]; }     g_Matrices;
layout(set = 2, binding = 0) readonly buffer AABBs        { AABB aabbs[]; }      g_AABBs;
layout(set = 2, binding = 1) readonly buffer RejectedCmds { RejectedCommand cmds[]; } g_Rejected;
layout(set = 2, binding = 2) buffer OutputCmds            { IndirectCommand cmds[]; } g_Output;
layout(set = 2, binding = 3) buffer CountersB             { uint counters[]; }   g_CountersB;
layout(set = 2, binding = 4) readonly buffer CountersRej  { uint counters[]; }   g_CountersRej;
layout(set = 2, binding = 5) readonly buffer RegionBases  { uint base[]; }       g_RegionBases;
layout(set = 2, binding = 6) uniform sampler2D g_HiZ;
layout(set = 2, binding = 7) buffer Totals { uint counters[]; } g_Totals;

layout(push_constant) uniform PushConstants
{
    vec4 planes[6];
    uint maxCount;
    uint materialCount;
    uint hizMipCount;
    float depthBias;
} g_PC;

bool occlusionCulled(vec3 wMin, vec3 wMax)
{
    mat4 viewProj = g_BaseData.projMat * g_BaseData.viewMat;

    vec2 rectMin = vec2(1e9);
    vec2 rectMax = vec2(-1e9);
    float nearestDepth = 1.0;

    for (int i = 0; i < 8; ++i)
    {
        vec3 corner = mix(wMin, wMax, vec3((i & 1) != 0 ? 1.0 : 0.0,
                                           (i & 2) != 0 ? 1.0 : 0.0,
                                           (i & 4) != 0 ? 1.0 : 0.0));
        vec4 clip = viewProj * vec4(corner, 1.0);
        if (clip.w <= 0.0)
            return false;
        vec3 ndc = clip.xyz / clip.w;
        vec2 uv = ndc.xy * 0.5 + 0.5;
        rectMin = min(rectMin, uv);
        rectMax = max(rectMax, uv);
        nearestDepth = min(nearestDepth, ndc.z);
    }

    if (nearestDepth <= 0.0)
        return false;

    rectMin = clamp(rectMin, vec2(0.0), vec2(1.0));
    rectMax = clamp(rectMax, vec2(0.0), vec2(1.0));
    if (rectMax.x <= rectMin.x || rectMax.y <= rectMin.y)
        return false;

    ivec2 hizSize = textureSize(g_HiZ, 0) * 2;
    vec2 rectPx = (rectMax - rectMin) * vec2(hizSize);
    float maxExtent = max(rectPx.x, rectPx.y);
    int mip = clamp(int(floor(log2(max(maxExtent, 1.0)))) - 1, 0, int(g_PC.hizMipCount) - 1);

    float d0 = textureLod(g_HiZ, vec2(rectMin.x, rectMin.y), float(mip)).r;
    float d1 = textureLod(g_HiZ, vec2(rectMax.x, rectMin.y), float(mip)).r;
    float d2 = textureLod(g_HiZ, vec2(rectMin.x, rectMax.y), float(mip)).r;
    float d3 = textureLod(g_HiZ, vec2(rectMax.x, rectMax.y), float(mip)).r;
    float occluderDepth = max(max(d0, d1), max(d2, d3));

    return nearestDepth > occluderDepth + g_PC.depthBias;
}

void main()
{
    uint i = gl_GlobalInvocationID.x;
    uint rejCount = g_CountersRej.counters[0];
    if (i >= rejCount || i >= g_PC.maxCount)
        return;

    RejectedCommand rej = g_Rejected.cmds[i];
    IndirectCommand cmd = rej.cmd;
    uint orig = cmd.firstInstance;

    AABB a = g_AABBs.aabbs[orig];
    mat4 m = g_Matrices.models[orig];

    vec3 center   = (a.min.xyz + a.max.xyz) * 0.5;
    vec3 halfSize = (a.max.xyz - a.min.xyz) * 0.5;
    vec3 worldCenter = vec3(m * vec4(center, 1.0));
    mat3 rot = mat3(m);
    mat3 absRot = mat3(abs(rot[0]), abs(rot[1]), abs(rot[2]));
    halfSize = absRot * halfSize;

    if (occlusionCulled(worldCenter - halfSize, worldCenter + halfSize))
        return; // still occluded by same-frame depth

    uint mat = rej.materialId;
    uint outSlot = atomicAdd(g_CountersB.counters[mat], 1u);
    g_Output.cmds[g_RegionBases.base[mat] + outSlot] = cmd;
    atomicAdd(g_CountersB.counters[g_PC.materialCount], 1u);
    atomicAdd(g_Totals.counters[2], 1u);
}
